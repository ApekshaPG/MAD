        <TextView
            android:text="Name"
            android:textStyle="bold"
            android:padding="8dp"/>

        <TextView
            android:text="Age"
            android:textStyle="bold"
            android:padding="8dp"/>
    </TableRow>

    <!-- Row 2 -->
    <TableRow>
        <TextView
            android:text="Apeksha"
            android:padding="8dp"/>

        <TextView
            android:text="21"
            android:padding="8dp"/>
    </TableRow>

    <!-- Row 3 -->
    <TableRow>
        <TextView
            android:text="Rahul"
            android:padding="8dp"/>

        <TextView
            android:text="22"
            android:padding="8dp"/>
    </TableRow>

</TableLayout>